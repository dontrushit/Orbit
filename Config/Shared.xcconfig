// Settings shared by every target. Machine-specific values live in Local.xcconfig.

ORBIT_BUNDLE_ID = dev.orbit.mac

// macOS-style App Group (Team ID prefix): no provisioning profile, no access prompt on macOS 15+.
ORBIT_APP_GROUP_ID = $(TeamIdentifierPrefix)$(ORBIT_BUNDLE_ID).shared

MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 3

#include? "Local.xcconfig"
