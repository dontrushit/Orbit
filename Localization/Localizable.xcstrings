{
  "sourceLanguage": "en",
  "strings": {
    "About Orbit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе Orbit"
          }
        }
      }
    },
    "Adds the features macOS is missing.\nWorks locally: no servers, accounts or telemetry.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет функции, которых нет в macOS.\nРаботает локально: без серверов, аккаунтов и телеметрии."
          }
        }
      }
    },
    "Conversion happens on this Mac. Documents aren’t uploaded anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертация выполняется на этом Mac. Документы никуда не загружаются."
          }
        }
      }
    },
    "Convert Word documents to PDF right from the Finder context menu, without Microsoft Word.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертируйте документы Word в PDF прямо из контекстного меню Finder, без Microsoft Word."
          }
        }
      },
      "extractionState": "manual"
    },
    "Convert to PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертировать в PDF"
          }
        }
      },
      "extractionState": "manual"
    },
    "Copy Path": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать путь"
          }
        }
      },
      "extractionState": "manual"
    },
    "Copy the full path of files and folders right from the Finder context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируйте полный путь к файлам и папкам прямо из контекстного меню Finder."
          }
        }
      },
      "extractionState": "manual"
    },
    "Create text, Markdown, JSON and HTML files right from the Finder context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте текстовые файлы, Markdown, JSON и HTML прямо из контекстного меню Finder."
          }
        }
      },
      "extractionState": "manual"
    },
    "Each file type is a separate item, such as “New Text File”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый тип файла — отдельный пункт, например «Новый текстовый файл»."
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено"
          }
        }
      }
    },
    "File Name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя файла"
          }
        }
      }
    },
    "File Types": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типы файлов"
          }
        }
      }
    },
    "File types are grouped in the “New File” submenu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типы файлов собраны в подменю «Новый файл»."
          }
        }
      }
    },
    "Finder Menu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню Finder"
          }
        }
      }
    },
    "Finder extension is turned off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение Finder выключено"
          }
        }
      }
    },
    "Full Path": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный путь"
          }
        }
      }
    },
    "HTML": {
      "shouldTranslate": false,
      "extractionState": "manual"
    },
    "How It Works": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это работает"
          }
        }
      }
    },
    "JSON": {
      "shouldTranslate": false,
      "extractionState": "manual"
    },
    "Markdown": {
      "shouldTranslate": false,
      "extractionState": "manual"
    },
    "Modules": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модули"
          }
        }
      }
    },
    "New File": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл"
          }
        }
      },
      "extractionState": "manual"
    },
    "New HTML File": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл HTML"
          }
        }
      },
      "extractionState": "manual"
    },
    "New JSON File": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл JSON"
          }
        }
      },
      "extractionState": "manual"
    },
    "New Markdown File": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл Markdown"
          }
        }
      },
      "extractionState": "manual"
    },
    "New Text File": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый текстовый файл"
          }
        }
      },
      "extractionState": "manual"
    },
    "New files are named “%@.txt”, “%@ 2.txt” and so on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые файлы называются «%1$@.txt», «%2$@ 2.txt» и так далее."
          }
        }
      }
    },
    "Orbit": {
      "shouldTranslate": false
    },
    "Path Format": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат пути"
          }
        }
      }
    },
    "Paths look like “%@”. When several items are selected, each path goes on its own line.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пути выглядят как «%@». Если выделено несколько объектов, каждый путь — с новой строки."
          }
        }
      }
    },
    "Pictures in EMF and WMF formats, such as equations from the old Equation Editor, appear as empty frames. Footnotes are placed at the end of the document.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисунки в форматах EMF и WMF, например формулы из старого редактора формул, показываются пустыми рамками. Сноски размещаются в конце документа."
          }
        }
      }
    },
    "Plain Text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простой текст"
          }
        }
      },
      "extractionState": "manual"
    },
    "Relative to Home Folder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относительно домашней папки"
          }
        }
      }
    },
    "Select Word documents in Finder, Control-click and choose Convert to PDF.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите документы Word в Finder, нажмите их, удерживая клавишу Control, и выберите «Конвертировать в PDF»."
          }
        }
      }
    },
    "Separate Items": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельные пункты"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Submenu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подменю"
          }
        }
      }
    },
    "The PDF is saved next to the document. An existing file is never replaced.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF сохраняется рядом с документом. Существующие файлы не заменяются."
          }
        }
      }
    },
    "The menu isn’t available in iCloud Drive folders, including Desktop and Documents when they’re stored in iCloud.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню недоступно в папках iCloud Drive, в том числе на рабочем столе и в «Документах», если они хранятся в iCloud."
          }
        }
      }
    },
    "Turn On…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить…"
          }
        }
      }
    },
    "Turn on Orbit in General → Login Items & Extensions → Finder to add items to the context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Orbit в разделе «Основные → Объекты входа и расширения → Finder», чтобы добавить пункты в контекстное меню."
          }
        }
      }
    },
    "Turn on at least one file type to see New File in Finder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите хотя бы один тип файла, чтобы «Новый файл» появился в Finder."
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без названия"
          }
        }
      },
      "extractionState": "manual"
    },
    "Word to PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Word в PDF"
          }
        }
      },
      "extractionState": "manual"
    }
  },
  "version": "1.0"
}
