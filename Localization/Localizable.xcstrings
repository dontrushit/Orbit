    },
    "Split": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделить"
          }
        }
      }
    },
    "Split %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделить %@"
          }
        }
      }
    },
    "Split PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделить PDF"
          }
        }
      },
      "extractionState": "manual"
    },
    "Split PDF…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделить PDF…"
          }
        }
      },
      "extractionState": "manual"
    },
    "Splitting…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделение…"
          }
        }
      }
    },
    "Submenu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подменю"
          }
        }
      }
    },
    "The PDF file couldn’t be saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить PDF-файл."
          }
        }
      }
    },
    "The PDF is saved next to the document. An existing file is never replaced.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF сохраняется рядом с документом. Существующие файлы не заменяются."
          }
        }
      }
    },
    "The menu isn’t available in iCloud Drive folders, including Desktop and Documents when they’re stored in iCloud.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню недоступно в папках iCloud Drive, в том числе на рабочем столе и в «Документах», если они хранятся в iCloud."
          }
        }
      }
    },
    "The merged PDF is saved next to the first file, the pages of a split PDF in a new folder next to it. An existing file is never replaced.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединённый PDF сохраняется рядом с первым файлом, страницы разделённого — в новой папке рядом с ним. Существующие файлы не заменяются."
          }
        }
      }
    },
    "Turn On…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить…"
          }
        }
      }
    },
    "Turn on Orbit in General → Login Items & Extensions → Finder to add items to the context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Orbit в разделе «Основные → Объекты входа и расширения → Finder», чтобы добавить пункты в контекстное меню."
          }
        }
      }
    },
    "Turn on at least one file type to see New File in Finder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите хотя бы один тип файла, чтобы «Новый файл» появился в Finder."
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без названия"
          }
        }
      },
      "extractionState": "manual"
    },
    "Word to PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Word в PDF"
          }
        }
      },
      "extractionState": "manual"
    },
    "“%@” can’t be read. It may be damaged or not a PDF file.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не читается. Возможно, файл повреждён или это не PDF."
          }
        }
      }
    },
    "“%@” changed while the window was open. Close the window and try again to see its current pages.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» изменился, пока окно было открыто. Закройте окно и попробуйте снова, чтобы увидеть его текущие страницы."
          }
        }
      }
    },
    "“%@” has only one page, so there’s nothing to split.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» только одна страница — разделять нечего."
          }
        }
