    "New files are named “%@.txt”, “%@ 2.txt” and so on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые файлы называются «%1$@.txt», «%2$@ 2.txt» и так далее."
          }
        }
      }
    },
    "Not selected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выбрана"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ОК"
          }
        }
      }
    },
    "One of the files can’t be read. Close the window and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один из файлов не читается. Закройте окно и попробуйте снова."
          }
        }
      }
    },
    "Orbit": {
      "shouldTranslate": false
    },
    "PDF Tools": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты PDF"
          }
        }
      },
      "extractionState": "manual"
    },
    "PDF files are processed on this Mac. They aren’t uploaded anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-файлы обрабатываются на этом Mac. Они никуда не загружаются."
          }
        }
      }
    },
    "Page %lld, %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница %1$lld, %2$@"
          }
        }
      }
    },
    "Path Format": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат пути"
          }
        }
      }
    },
    "Paths look like “%@”. When several items are selected, each path goes on its own line.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пути выглядят как «%@». Если выделено несколько объектов, каждый путь — с новой строки."
          }
        }
      }
    },
    "Pictures in EMF and WMF formats, such as equations from the old Equation Editor, appear as empty frames. Footnotes are placed at the end of the document.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисунки в форматах EMF и WMF, например формулы из старого редактора формул, показываются пустыми рамками. Сноски размещаются в конце документа."
          }
        }
      }
    },
    "Plain Text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простой текст"
          }
        }
      },
      "extractionState": "manual"
    },
    "Relative to Home Folder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относительно домашней папки"
          }
        }
      }
    },
    "Save As": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить как"
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать все"
          }
        }
      }
    },
    "Select Word documents in Finder, Control-click and choose Convert to PDF.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите документы Word в Finder, нажмите их, удерживая клавишу Control, и выберите «Конвертировать в PDF»."
          }
        }
      }
    },
    "Select one PDF file and choose Split PDF to save each page as a separate file.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите один PDF-файл и выберите «Разделить PDF», чтобы сохранить каждую страницу отдельным файлом."
          }
        }
      }
    },
    "Select several PDF files in Finder, Control-click and choose Merge PDFs. Pages follow the order of file names.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите несколько PDF-файлов в Finder, нажмите их, удерживая клавишу Control, и выберите «Объединить PDF». Страницы идут в порядке имён файлов."
          }
        }
      }
    },
    "Selected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана"
          }
        }
      }
    },
    "Selected pages in one file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одним файлом"
          }
        }
      }
    },
    "Separate Items": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельные пункты"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
