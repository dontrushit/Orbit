{
  "sourceLanguage": "en",
  "strings": {
    "%@ (merged)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (объединённый)"
          }
        }
      },
      "extractionState": "manual"
    },
    "%@ (pages)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (выбранные страницы)"
          }
        }
      },
      "extractionState": "manual"
    },
    "%@ Pages": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — страницы"
          }
        }
      },
      "extractionState": "manual"
    },
    "%lld of %lld pages": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld из %2$lld стр."
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано: %lld"
          }
        }
      }
    },
    "About Orbit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе Orbit"
          }
        }
      }
    },
    "Adds the features macOS is missing.\nWorks locally: no servers, accounts or telemetry.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет функции, которых нет в macOS.\nРаботает локально: без серверов, аккаунтов и телеметрии."
          }
        }
      }
    },
    "Bookmarks (the table of contents) aren’t kept when files are merged. Password-protected PDF files can’t be merged or split.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При объединении закладки (оглавление) не сохраняются. PDF-файлы, защищённые паролем, нельзя объединить или разделить."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Can’t Merge PDFs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось объединить PDF"
          }
        }
      }
    },
    "Can’t Split PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разделить PDF"
          }
        }
      }
    },
    "Choose pages and order first": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выбирать страницы и порядок"
          }
        }
      }
    },
    "Choose pages first": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выбирать страницы"
          }
        }
      }
    },
    "Click a page to exclude it. Drag to reorder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на страницу, чтобы исключить её, или перетащите, чтобы изменить порядок."
          }
        }
      }
    },
    "Click a page to select it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на страницу, чтобы выбрать её."
          }
        }
      }
    },
    "Conversion happens on this Mac. Documents aren’t uploaded anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертация выполняется на этом Mac. Документы никуда не загружаются."
          }
        }
      }
    },
    "Convert Word documents to PDF right from the Finder context menu, without Microsoft Word.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертируйте документы Word в PDF прямо из контекстного меню Finder, без Microsoft Word."
          }
        }
      },
      "extractionState": "manual"
    },
    "Convert to PDF": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертировать в PDF"
          }
        }
      },
      "extractionState": "manual"
    },
    "Copy Path": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать путь"
          }
        }
      },
      "extractionState": "manual"
    },
    "Copy the full path of files and folders right from the Finder context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируйте полный путь к файлам и папкам прямо из контекстного меню Finder."
          }
        }
      },
      "extractionState": "manual"
    },
    "Create text, Markdown, JSON and HTML files right from the Finder context menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте текстовые файлы, Markdown, JSON и HTML прямо из контекстного меню Finder."
          }
        }
      },
      "extractionState": "manual"
    },
    "Deselect All": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять выбор"
          }
        }
      }
    },
    "Each file type is a separate item, such as “New Text File”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый тип файла — отдельный пункт, например «Новый текстовый файл»."
          }
        }
      }
    },
    "Each page as a separate file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждую страницу отдельным файлом"
          }
        }
      }
    },
    "Each selected page as a separate file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая страница — отдельным файлом"
